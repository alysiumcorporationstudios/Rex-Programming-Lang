{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rex",
  "scopeName": "source.rex",
  "fileTypes": ["rex"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-definition" },
    { "include": "#control-keywords" },
    { "include": "#namespaced-builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#word-operators" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rex",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rex",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.rex", "match": "\\\\[nrt0bf\"'\\\\/]" },
            { "name": "constant.character.escape.unicode.rex", "match": "\\\\u[0-9a-fA-F]{4}" },
            {
              "name": "meta.interpolation.rex",
              "begin": "\\$\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.rex" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.rex" } },
              "patterns": [
                { "include": "#comments" },
                { "include": "#namespaced-builtins" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#strings" },
                { "include": "#operators" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.rex",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.rex", "match": "\\\\[nrt0bf\"'\\\\/]" }
          ]
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "name": "meta.function.rex",
          "match": "\\b(rex)(\\.)(func)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.namespace.rex" },
            "2": { "name": "punctuation.accessor.rex" },
            "3": { "name": "keyword.control.rex" },
            "5": { "name": "entity.name.function.rex" }
          }
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "match": "\\b(rex)(\\.)(let|if|elif|else|end|while|for|func|return|break|continue|try|catch|throw|import|pass)\\b",
          "captures": {
            "1": { "name": "support.namespace.rex" },
            "2": { "name": "punctuation.accessor.rex" },
            "3": { "name": "keyword.control.rex" }
          }
        }
      ]
    },
    "namespaced-builtins": {
      "patterns": [
        {
          "match": "\\b(rex)(\\.)(show|input|exit|error|env|assert|get|post|put|patch|delete|request|read|write|append|exists|list_files|len|push|pop|sort|reverse|unique|keys|values|has|range|split|join|replace|upper|lower|trim|contains|starts_with|ends_with|type|str|num|bool|args|version|json|math|time|uuid)\\b",
          "captures": {
            "1": { "name": "support.namespace.rex" },
            "2": { "name": "punctuation.accessor.rex" },
            "3": { "name": "support.function.builtin.rex" }
          }
        },
        {
          "match": "\\b(rex)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.namespace.rex" },
            "2": { "name": "punctuation.accessor.rex" },
            "3": { "name": "support.function.rex" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.rex", "match": "\\b(true|false|null)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.rex", "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b" },
        { "name": "constant.numeric.integer.rex", "match": "\\b\\d[\\d_]*([eE][+-]?\\d+)?\\b" }
      ]
    },
    "word-operators": {
      "patterns": [
        { "name": "keyword.operator.word.rex", "match": "\\b(and|or|not|in)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.rex", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.rex", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.rex", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.assignment.rex", "match": "=" },
        { "name": "keyword.operator.other.rex", "match": "<|>" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.rex", "match": "[,;]" },
        { "name": "punctuation.accessor.rex", "match": "\\." },
        { "name": "punctuation.section.rex", "match": "[(){}\\[\\]]" }
      ]
    }
  }
}
